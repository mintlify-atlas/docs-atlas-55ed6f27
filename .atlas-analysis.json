  "keyFeatures": [
    "Fully normalized relational schema with 24 tables across 5 business domains",
    "Role-based access control with Roles, Permissions, and a User audit log (Bitácora)",
    "Inventory management with product categories, stock tracking, and reorder points",
    "Purchase order system with supplier management and itemized purchase detail",
    "Sales transactions covering both products and services with tax calculation",
    "Invoice and payment lifecycle with multiple payment methods and credit conditions",
    "Custom BOOL alias type for BIT columns for MER compatibility",
    "Structured file layout for stored procedures, triggers, reports, security, and backups"
  ],
